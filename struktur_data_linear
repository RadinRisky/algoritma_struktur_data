# linked list sederhana
class Node:
    def __init__(self, data):
        self.data = data
        self.next = None

# membuat node
n1 = Node(10)
n2 = Node(20)

n1.next = n2

print(n1.data)
print(n1.next.data)

# stack
stack = []

# push
stack.append(10)
stack.append(20)

# pop
stack.pop()

print(stack)

# queue
from collections import deque

queue = deque()

# enqueue
queue.append(10)
queue.append(20)

# dequeue
queue.popleft()

print(queue)

