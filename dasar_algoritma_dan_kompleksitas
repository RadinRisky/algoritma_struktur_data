# menentukan nilai maksimum dalam sebuah array
A = [3, 7, 2, 9, 5]
max = A[0]
for i in range (1, 5):
    if A[i] > max :
        max = A[i]
print ("Nilai Maksimum :", max)

# menentukan list bilangan prima
n = int(input("masukkan angka :"))
angka = list(range(n + 1))
for i in range (2, n + 1):
    for j in range (2, i):
        if i % j == 0:
            angka[i] = 0
print ("Bilangan Prima :")
for i in range (2, n + 1):
    if angka[i] != 0:
        print (i, end = " ")
